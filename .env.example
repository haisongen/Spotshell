# SpotShell 环境配置

# 模型 Provider（未设置时保持旧行为，默认 openai）
SPOTSHELL_MODEL_PROVIDER=openai

# OpenAI / OpenAI-compatible 配置
OPENAI_API_KEY=your_api_key_here

# 可选：自定义 API 地址（用于代理或兼容 API）
# OPENAI_BASE_URL=https://api.openai.com/v1

# 可选：指定模型（默认 gpt-4o-mini）
# OPENAI_MODEL=gpt-4o-mini

# Anthropic 配置（SPOTSHELL_MODEL_PROVIDER=anthropic 时只读取这一组）
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 可选：Anthropic 自定义 API 地址
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# 可选：指定 Anthropic 模型（默认 claude-sonnet-4-5）
# ANTHROPIC_MODEL=claude-sonnet-4-5
